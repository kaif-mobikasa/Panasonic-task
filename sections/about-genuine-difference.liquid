{{ 'about-genuine-difference.css' | asset_url | stylesheet_tag }}

<div
  class="about-genuine-diff"
  id="AboutGenuineDiff-{{ section.id }}"
  style="
    --diff-bg-color: {{ section.settings.background_color | default: '#ffffff' }};
    --diff-highlight-color: {{ section.settings.highlight_color | default: '#0041c0' }};
    --diff-padding-top: {{ section.settings.padding_top | default: 64 }}px;
    --diff-padding-bottom: {{ section.settings.padding_bottom | default: 72 }}px;
    --diff-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 36 }}px;
    --diff-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
  "
>
  <div class="about-genuine-diff-container">
    {%- if section.settings.heading_prefix != blank or section.settings.heading_highlight != blank -%}
      <div class="about-genuine-diff-header">
        <h2 class="about-genuine-diff-heading">
          {%- if section.settings.heading_prefix != blank -%}
            <span class="about-genuine-diff-heading-prefix">{{ section.settings.heading_prefix | escape }} </span>
          {%- endif -%}
          {%- if section.settings.heading_highlight != blank -%}
            <span class="about-genuine-diff-heading-highlight">{{ section.settings.heading_highlight | escape }}</span>
          {%- endif -%}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="about-genuine-diff-grid">
        {%- for block in section.blocks -%}
          <div
            class="about-genuine-diff-card"
            id="AboutGenuineDiffCard-{{ block.id }}"
            style="
              --diff-icon-bg: {{ block.settings.icon_bg_color | default: '#ebf3ff' }};
              --diff-icon-color: {{ block.settings.icon_color | default: '#0041c0' }};
            "
            {{ block.shopify_attributes }}
          >
            <div class="about-genuine-diff-card-head">
              {%- if block.settings.custom_image != blank or block.settings.custom_svg != blank -%}
                <div class="about-genuine-diff-icon-wrap" aria-hidden="true">
                  {%- if block.settings.custom_image != blank -%}
                    {{ block.settings.custom_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
                  {%- endif -%}

                  {%- if block.settings.custom_image == blank and block.settings.custom_svg != blank -%}
                    {{ block.settings.custom_svg }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="about-genuine-diff-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
            </div>

            {%- if block.settings.description != blank -%}
              <p class="about-genuine-diff-desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "The Genuine Difference",
  "tag": "section",
  "class": "section-about-genuine-diff",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "The Genuine"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight",
      "default": "Difference"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color",
      "default": "#0041C0"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code",
          "info": "Optional inline SVG code if icon image is not provided"
        },
        {
          "type": "color",
          "id": "icon_bg_color",
          "label": "Icon Background Color",
          "default": "#EBF3FF"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#0041C0"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Original Performance"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Replace worn components without compromising how your appliance was designed to work."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Genuine Difference",
      "settings": {
        "heading_prefix": "The Genuine",
        "heading_highlight": "Difference",
        "highlight_color": "#0041C0",
        "padding_top": 64,
        "padding_bottom": 72,
        "padding_top_mobile": 36,
        "padding_bottom_mobile": 48
      },
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "title": "Original Performance",
            "description": "Replace worn components without compromising how your appliance was designed to work."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Quality You Can Trust",
            "description": "Every part follows Panasonic manufacturing and quality standards for consistent results."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Perfect Compatibility",
            "description": "Parts are made to your model's exact specifications for the right fit and reliable operation."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Extend Product Life",
            "description": "Keep appliances in use longer by replacing individual components when they wear out."
          }
        }
      ]
    }
  ]
}
{% endschema %}
