{{ 'custom-footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-footer.js' | asset_url }}" defer="defer"></script>

<style>
  #hp-footer-{{ section.id }} .hp-footer-logo {
    width: {{ section.settings.logo_width | default: 236 }}px;
  }
</style>

<div class="hp-footer-wrapper" id="hp-footer-{{ section.id }}" data-section-id="{{ section.id }}">
  <footer class="hp-footer">
    <div class="hp-footer-container">
      <div class="hp-footer-grid">
        <!-- Brand & Contact Info Column -->
        <div class="hp-footer-brand">
          <div class="hp-footer-logo-wrap">
            <a href="{{ routes.root_url }}" class="hp-footer-logo-link" aria-label="{{ shop.name }}">
              {%- if section.settings.logo != blank -%}
                {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
                {{ section.settings.logo | image_url: width: 500 | image_tag: class: 'hp-footer-logo', alt: logo_alt, loading: 'lazy' }}
              {%- else -%}
                <img
                  src="data:image/png;base64,"
                  alt="Panasonic, powered by encompass — A Parts Town unlimited Company"
                  class="hp-footer-logo"
                  width="236"
                  height="64"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
          </div>

          <!-- Contact items -->
          <div class="hp-footer-contacts">
            {%- if section.settings.address != blank -%}
              <a
                {% if section.settings.address_url != blank %}href="{{ section.settings.address_url }}" target="_blank" rel="noopener noreferrer"{% else %}href="#"{% endif %}
                class="hp-footer-contact-item"
              >
                <span class="hp-footer-contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"></path>
                    <circle cx="12" cy="10" r="2.4"></circle>
                  </svg>
                </span>
                <span class="hp-footer-contact-text">
                  {{ section.settings.address | newline_to_br }}
                </span>
              </a>
            {%- endif -%}

            {%- if section.settings.phone != blank -%}
              <a
                href="{% if section.settings.phone_url != blank %}{{ section.settings.phone_url }}{% else %}tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}{% endif %}"
                class="hp-footer-contact-item"
              >
                <span class="hp-footer-contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5.2 3.8h3.2l1.6 4-2 1.3a11 11 0 0 0 5 5l1.3-2 4 1.6v3.2a1.7 1.7 0 0 1-1.8 1.7A15.5 15.5 0 0 1 3.5 5.6a1.7 1.7 0 0 1 1.7-1.8Z"></path>
                  </svg>
                </span>
                <span class="hp-footer-contact-text">{{ section.settings.phone }}</span>
              </a>
            {%- endif -%}

            {%- if section.settings.email != blank -%}
              <a
                href="{% if section.settings.email_url != blank %}{{ section.settings.email_url }}{% else %}mailto:{{ section.settings.email }}{% endif %}"
                class="hp-footer-contact-item"
              >
                <span class="hp-footer-contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5.5" width="18" height="13" rx="2"></rect>
                    <path d="m3.6 6.6 8.4 6.4 8.4-6.4"></path>
                  </svg>
                </span>
                <span class="hp-footer-contact-text">{{ section.settings.email }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>

        <!-- Column 1: All Parts -->
        <div class="hp-footer-col">
          <button type="button" class="hp-footer-acc-btn" aria-expanded="false" aria-controls="hp-footer-menu-1-{{ section.id }}">
            <span class="hp-footer-col-title">{{ section.settings.menu_1_title | default: 'All Parts' }}</span>
            <span class="hp-footer-acc-chev" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </button>
          <div class="hp-footer-links-wrap" id="hp-footer-menu-1-{{ section.id }}">
            <div class="hp-footer-links-inner">
              <ul class="hp-footer-links" role="list">
                {%- if section.settings.menu_1 != blank and linklists[section.settings.menu_1].links.size > 0 -%}
                  {%- for link in linklists[section.settings.menu_1].links -%}
                    <li>
                      <a href="{{ link.url }}" class="hp-footer-link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a href="#" class="hp-footer-link">Kitchen</a></li>
                  <li><a href="#" class="hp-footer-link">Personal Care</a></li>
                  <li><a href="#" class="hp-footer-link">Telephone &amp; Smart Home</a></li>
                  <li><a href="#" class="hp-footer-link">Audio &amp; Entertainment</a></li>
                  <li><a href="#" class="hp-footer-link">Home</a></li>
                  <li><a href="#" class="hp-footer-link">Heating &amp; Cooling</a></li>
                  <li><a href="#" class="hp-footer-link">TV &amp; AV</a></li>
                  <li><a href="#" class="hp-footer-link">Cameras &amp; Camcorders</a></li>
                  <li><a href="#" class="hp-footer-link">Batteries &amp; Power</a></li>
                  <li><a href="#" class="hp-footer-link">Other Products</a></li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        </div>

        <!-- Column 2: Information -->
        <div class="hp-footer-col">
          <button type="button" class="hp-footer-acc-btn" aria-expanded="false" aria-controls="hp-footer-menu-2-{{ section.id }}">
            <span class="hp-footer-col-title">{{ section.settings.menu_2_title | default: 'Information' }}</span>
            <span class="hp-footer-acc-chev" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </button>
          <div class="hp-footer-links-wrap" id="hp-footer-menu-2-{{ section.id }}">
            <div class="hp-footer-links-inner">
              <ul class="hp-footer-links" role="list">
                {%- if section.settings.menu_2 != blank and linklists[section.settings.menu_2].links.size > 0 -%}
                  {%- for link in linklists[section.settings.menu_2].links -%}
                    <li>
                      <a href="{{ link.url }}" class="hp-footer-link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a href="#" class="hp-footer-link">About Us</a></li>
                  <li><a href="#" class="hp-footer-link">Cancel/Return A Part</a></li>
                  <li><a href="#" class="hp-footer-link">Contact Us</a></li>
                  <li><a href="#" class="hp-footer-link">My Account</a></li>
                  <li><a href="#" class="hp-footer-link">Sitemap</a></li>
                  <li><a href="#" class="hp-footer-link">Blog</a></li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        </div>

        <!-- Column 3: Legal -->
        <div class="hp-footer-col">
          <button type="button" class="hp-footer-acc-btn" aria-expanded="false" aria-controls="hp-footer-menu-3-{{ section.id }}">
            <span class="hp-footer-col-title">{{ section.settings.menu_3_title | default: 'Legal' }}</span>
            <span class="hp-footer-acc-chev" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </button>
          <div class="hp-footer-links-wrap" id="hp-footer-menu-3-{{ section.id }}">
            <div class="hp-footer-links-inner">
              <ul class="hp-footer-links" role="list">
                {%- if section.settings.menu_3 != blank and linklists[section.settings.menu_3].links.size > 0 -%}
                  {%- for link in linklists[section.settings.menu_3].links -%}
                    <li>
                      <a href="{{ link.url }}" class="hp-footer-link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a href="#" class="hp-footer-link">Cookie Policy</a></li>
                  <li><a href="#" class="hp-footer-link">Cookies Settings</a></li>
                  <li><a href="#" class="hp-footer-link">Privacy Policy</a></li>
                  <li><a href="#" class="hp-footer-link">Privacy Request</a></li>
                  <li><a href="#" class="hp-footer-link">Shipping &amp; Delivery Policy</a></li>
                  <li><a href="#" class="hp-footer-link">Returns &amp; Exchanges Policy</a></li>
                  <li><a href="#" class="hp-footer-link">Terms &amp; Conditions</a></li>
                  <li><a href="#" class="hp-footer-link">Terms Of Use</a></li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Copyright Bar -->
      {%- if section.settings.copyright_text != blank -%}
        <div class="hp-footer-bottom">
          <span class="hp-footer-copy">
            {{ section.settings.copyright_text }}
          </span>
        </div>
      {%- endif -%}
    </div>
  </footer>

  <!-- Globe & Slogan Horizon Band -->
  {%- if section.settings.show_globe -%}
    <div class="hp-footer-globe-band">
      <div class="hp-footer-globe-fx" aria-hidden="true">
        <canvas class="hp-footer-globe-canvas" id="hp-footer-globe-{{ section.id }}" aria-hidden="true"></canvas>
        <svg class="hp-footer-globe-svg" viewBox="0 0 2103 748" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
          <defs>
            <radialGradient id="fgGlow-{{ section.id }}">
              <stop offset="0" stop-color="#FFFFFF" stop-opacity="1"></stop>
              <stop offset="0.35" stop-color="#BFDAFF" stop-opacity="0.8"></stop>
              <stop offset="1" stop-color="#6FA8F0" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <!-- Orbit 1 -->
          <path d="M -40 700 C 600 520, 1500 520, 2143 700" fill="none" stroke="#6FA8F0" stroke-width="1.44" stroke-opacity="0.22"></path>
          <path d="M -40 700 C 600 520, 1500 520, 2143 700" fill="none" stroke="#4F93EE" stroke-width="2.4" stroke-opacity="0.6" stroke-linecap="round" stroke-dasharray="180 2300">
            <animate attributeName="stroke-dashoffset" values="2480; 0" dur="7s" repeatCount="indefinite"></animate>
          </path>
          <circle r="16" fill="url(#fgGlow-{{ section.id }})">
            <animateMotion path="M -40 700 C 600 520, 1500 520, 2143 700" dur="7s" repeatCount="indefinite" begin="0s"></animateMotion>
          </circle>

          <!-- Orbit 2 -->
          <path d="M -40 640 C 700 560, 1400 700, 2143 612" fill="none" stroke="#6FA8F0" stroke-width="1.2" stroke-opacity="0.22"></path>
          <path d="M -40 640 C 700 560, 1400 700, 2143 612" fill="none" stroke="#4F93EE" stroke-width="2" stroke-opacity="0.6" stroke-linecap="round" stroke-dasharray="180 2300">
            <animate attributeName="stroke-dashoffset" values="2480; 0" dur="10s" repeatCount="indefinite"></animate>
          </path>
          <circle r="16" fill="url(#fgGlow-{{ section.id }})">
            <animateMotion path="M -40 640 C 700 560, 1400 700, 2143 612" dur="10s" repeatCount="indefinite" begin="-1.3s"></animateMotion>
          </circle>

          <!-- Orbit 3 -->
          <path d="M 160 748 C 680 598, 1420 598, 1940 748" fill="none" stroke="#6FA8F0" stroke-width="1.32" stroke-opacity="0.22"></path>
          <path d="M 160 748 C 680 598, 1420 598, 1940 748" fill="none" stroke="#4F93EE" stroke-width="2.2" stroke-opacity="0.6" stroke-linecap="round" stroke-dasharray="180 2300">
            <animate attributeName="stroke-dashoffset" values="2480; 0" dur="8.5s" repeatCount="indefinite"></animate>
          </path>
          <circle r="16" fill="url(#fgGlow-{{ section.id }})">
            <animateMotion path="M 160 748 C 680 598, 1420 598, 1940 748" dur="8.5s" repeatCount="indefinite" begin="-2.6s"></animateMotion>
          </circle>
        </svg>
      </div>

      <div class="hp-footer-slogan-wrap">
        <span class="hp-footer-slogan">
          {{ section.settings.slogan_left | default: 'A Better' }}
          {% if section.settings.slogan_left_highlight != blank %}
            <span class="hp-text-brand">{{ section.settings.slogan_left_highlight }}</span>
          {% endif %}
        </span>
        <span class="hp-footer-slogan">
          {{ section.settings.slogan_right | default: 'A Better' }}
          {% if section.settings.slogan_right_highlight != blank %}
            <span class="hp-text-brand">{{ section.settings.slogan_right_highlight }}</span>
          {% endif %}
        </span>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "section-custom-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand & Contact"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 150,
      "max": 350,
      "step": 2,
      "unit": "px",
      "label": "Logo Width",
      "default": 236
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "775 Tipton Industrial Dr Suite F\nLawrenceville, GA 30046"
    },
    {
      "type": "url",
      "id": "address_url",
      "label": "Address Link (Optional)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "1-800-211-7262"
    },
    {
      "type": "text",
      "id": "phone_url",
      "label": "Phone Link",
      "default": "tel:18002117262"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "support@panasonicparts.com"
    },
    {
      "type": "text",
      "id": "email_url",
      "label": "Email Link",
      "default": "mailto:support@panasonicparts.com"
    },
    {
      "type": "header",
      "content": "Navigation Column 1"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Column 1 Heading",
      "default": "All Parts"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 Menu"
    },
    {
      "type": "header",
      "content": "Navigation Column 2"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Column 2 Heading",
      "default": "Information"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 Menu"
    },
    {
      "type": "header",
      "content": "Navigation Column 3"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Column 3 Heading",
      "default": "Legal"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Column 3 Menu"
    },
    {
      "type": "header",
      "content": "Copyright Bar"
    },
    {
      "type": "textarea",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Copyright © 2026 Encompass Supply Chain Solutions, Inc. All Rights Reserved."
    },
    {
      "type": "header",
      "content": "Globe & Slogan Horizon"
    },
    {
      "type": "checkbox",
      "id": "show_globe",
      "label": "Show Globe & Slogan Band",
      "default": true
    },
    {
      "type": "text",
      "id": "slogan_left",
      "label": "Left Slogan Text",
      "default": "A Better"
    },
    {
      "type": "text",
      "id": "slogan_left_highlight",
      "label": "Left Slogan Highlighted Word",
      "default": "Life,"
    },
    {
      "type": "text",
      "id": "slogan_right",
      "label": "Right Slogan Text",
      "default": "A Better"
    },
    {
      "type": "text",
      "id": "slogan_right_highlight",
      "label": "Right Slogan Highlighted Word",
      "default": "World!"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
