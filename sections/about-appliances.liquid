{{ 'about-appliances.css' | asset_url | stylesheet_tag }}

<div
  class="about-appliances"
  id="AboutAppliances-{{ section.id }}"
  style="
    --ap-bg-color: {{ section.settings.background_color | default: '#ffffff' }};
    --ap-highlight-color: {{ section.settings.highlight_color | default: '#0041c0' }};
    --ap-padding-top: {{ section.settings.padding_top | default: 56 }}px;
    --ap-padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
    --ap-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 36 }}px;
    --ap-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
  "
>
  <div class="about-appliances-container">
    {%- if section.settings.heading_prefix != blank or section.settings.heading_highlight != blank or section.settings.cta_text != blank -%}
      <div class="about-appliances-header">
        {%- if section.settings.heading_prefix != blank or section.settings.heading_highlight != blank -%}
          <h2 class="about-appliances-title">
            {%- if section.settings.heading_prefix != blank -%}
              <span class="about-appliances-title-prefix">{{ section.settings.heading_prefix | escape }} </span>
            {%- endif -%}
            {%- if section.settings.heading_highlight != blank -%}
              <span class="about-appliances-title-highlight">{{ section.settings.heading_highlight | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a
            href="{% if section.settings.cta_link != blank %}{{ section.settings.cta_link }}{% endif %}{% if section.settings.cta_link == blank %}{{ routes.collections_url }}{% endif %}"
            class="about-appliances-cta"
          >
            <span>{{ section.settings.cta_text | escape }}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="about-appliances-grid">
        {%- for block in section.blocks -%}
          <a
            href="{% if block.settings.url != blank %}{{ block.settings.url }}{% endif %}{% if block.settings.url == blank %}#{% endif %}"
            class="about-appliances-card"
            id="AboutApplianceCard-{{ block.id }}"
            style="--ap-icon-bg: {{ block.settings.icon_bg_color | default: '#ebf3ff' }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon_image != blank or block.settings.icon_svg != blank -%}
              <div class="about-appliances-icon-wrap" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 100 | image_tag: class: 'about-appliances-icon-img', loading: 'lazy', alt: block.settings.title | escape }}
                {%- endif -%}

                {%- if block.settings.icon_image == blank and block.settings.icon_svg != blank -%}
                  <span class="about-appliances-icon-svg">
                    {{ block.settings.icon_svg }}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <span class="about-appliances-name">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Appliances",
  "tag": "section",
  "class": "section-about-appliances",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "Shop Parts By"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight",
      "default": "Appliances"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color",
      "default": "#0041C0"
    },
    {
      "type": "header",
      "content": "Link / CTA Settings"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Link Text",
      "default": "Explore All Appliances"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link URL"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "appliance_item",
      "name": "Appliance",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG Code (Optional)",
          "info": "Used when Icon Image is not provided"
        },
        {
          "type": "color",
          "id": "icon_bg_color",
          "label": "Icon Circle Background",
          "default": "#EBF3FF"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Appliance Name",
          "default": "Microwave"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Appliances",
      "settings": {
        "heading_prefix": "Shop Parts By",
        "heading_highlight": "Appliances",
        "cta_text": "Explore All Appliances",
        "padding_top": 56,
        "padding_bottom": 64,
        "padding_top_mobile": 36,
        "padding_bottom_mobile": 48
      },
      "blocks": [
        {
          "type": "appliance_item",
          "settings": {
            "title": "Microwave"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "Vacuum Cleaner"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "Refrigerator"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "Shaver"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "Toaster"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "Cameras"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "Toothbrushes"
          }
        },
        {
          "type": "appliance_item",
          "settings": {
            "title": "HVAC"
          }
        }
      ]
    }
  ]
}
{% endschema %}
