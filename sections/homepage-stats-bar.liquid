{% comment %}
  Homepage Stats Bar Section - Panasonic Shopify OS 2.0 Theme
  Matches Figma UI specification with 4 stat/trust badges in a rounded card,
  light blue circular icon badges, vertical dividing lines, and customizable icon settings.
{% endcomment %}

{{ 'homepage-stats-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #hp-stats-bar-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 24 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;
    {%- if section.settings.section_bg != blank -%}
      background-color: {{ section.settings.section_bg }};
    {%- endif -%}
  }

  #hp-stats-bar-{{ section.id }} .hp-stats-card {
    {%- if section.settings.card_bg != blank -%}
      background-color: {{ section.settings.card_bg }};
    {%- endif -%}
  }

  #hp-stats-bar-{{ section.id }} .hp-stats-icon-badge {
    {%- if section.settings.icon_bg != blank -%}
      background-color: {{ section.settings.icon_bg }};
    {%- endif -%}
    {%- if section.settings.icon_color != blank -%}
      color: {{ section.settings.icon_color }};
    {%- endif -%}
  }

  #hp-stats-bar-{{ section.id }} .hp-stats-title {
    {%- if section.settings.title_color != blank -%}
      color: {{ section.settings.title_color }};
    {%- endif -%}
  }

  #hp-stats-bar-{{ section.id }} .hp-stats-subtitle {
    {%- if section.settings.subtitle_color != blank -%}
      color: {{ section.settings.subtitle_color }};
    {%- endif -%}
  }

  {%- if section.settings.show_dividers == false -%}
    #hp-stats-bar-{{ section.id }} .hp-stats-item {
      border-right: none !important;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="hp-stats-bar-section"
  id="hp-stats-bar-{{ section.id }}"
  aria-label="Features and Statistics"
>
  <div class="hp-stats-bar-container">
    <div class="hp-stats-card">
      <div class="hp-stats-grid" role="list">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank or block.settings.subtitle != blank or block.settings.custom_icon != blank or block.settings.custom_svg != blank -%}
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  class="hp-stats-item"
                  role="listitem"
                  {{ block.shopify_attributes }}
                >
              {%- else -%}
                <div
                  class="hp-stats-item"
                  role="listitem"
                  {{ block.shopify_attributes }}
                >
              {%- endif -%}

                <span class="hp-stats-icon-badge" aria-hidden="true">
                  {%- if block.settings.custom_svg != blank -%}
                    {{ block.settings.custom_svg }}
                  {%- elsif block.settings.custom_icon != blank -%}
                    {{ block.settings.custom_icon | image_url: width: 64 | image_tag: class: 'hp-stats-custom-img', loading: 'lazy', alt: block.settings.title | default: 'Feature icon' }}
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'users' -%}
                        <svg viewBox="-0.87 0.35 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="9" cy="8.6" r="3.1"></circle>
                          <path d="M3.4 19.2a5.9 5.9 0 0 1 11.2 0"></path>
                          <path d="M16.4 6.4a3 3 0 0 1 0 5.9M17.6 19.2a5.6 5.6 0 0 0-1.5-3.8"></path>
                        </svg>
                      {%- when 'genuine' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m12 3 2 1.6 2.5-.4 1 2.4 2.4 1-.4 2.5L21 12l-1.5 2-.4 2.5-2.4 1-1 2.4-2.5-.4L12 21l-2-1.5-2.5.4-1-2.4-2.4-1 .4-2.5L3 12l1.5-2-.4-2.5 2.4-1 1-2.4 2.5.4Z"></path>
                          <path d="m8.8 12 2.2 2.2 4.2-4.4"></path>
                        </svg>
                      {%- when 'truck' -%}
                        <svg viewBox="-1 0.8 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2.8 6.4h10.4v9.2H2.8z"></path>
                          <path d="M13.2 9.6h3.6l2.4 2.8v3.2h-6z"></path>
                          <circle cx="6.6" cy="17.4" r="1.8"></circle>
                          <circle cx="16.4" cy="17.4" r="1.8"></circle>
                        </svg>
                      {%- when 'support' -%}
                        <svg viewBox="0 1.05 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4.6 15.4v-3.2a7.4 7.4 0 0 1 14.8 0v3.2"></path>
                          <rect x="2.8" y="13.3" width="3.6" height="5.4" rx="1.6"></rect>
                          <rect x="17.6" y="13.3" width="3.6" height="5.4" rx="1.6"></rect>
                          <path d="M19.4 18.7a3.4 3.4 0 0 1-3.4 2.6h-1.6"></path>
                        </svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 3.4 4.9 6v5.6c0 4.2 2.9 7.4 7.1 8.9 4.2-1.5 7.1-4.7 7.1-8.9V6z"></path>
                          <path d="m9.1 11.9 2.1 2.1 3.8-4"></path>
                        </svg>
                      {%- when 'lock' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect>
                          <path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"></path>
                          <path d="M12 14.6v2.2"></path>
                        </svg>
                      {%- when 'return' -%}
                        <svg viewBox="0 2.28 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4.4 11.2A7.6 7.6 0 0 1 19.2 12.9"></path>
                          <path d="M4.2 6.2v5h5"></path>
                          <path d="M19.6 17.7a7.6 7.6 0 0 1-14.6-1.4"></path>
                          <path d="M19.8 21.4v-5h-5"></path>
                        </svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                      {%- else -%}
                        <svg viewBox="-0.87 0.35 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="9" cy="8.6" r="3.1"></circle>
                          <path d="M3.4 19.2a5.9 5.9 0 0 1 11.2 0"></path>
                          <path d="M16.4 6.4a3 3 0 0 1 0 5.9M17.6 19.2a5.6 5.6 0 0 0-1.5-3.8"></path>
                        </svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>

                <span class="hp-stats-text">
                  {%- if block.settings.title != blank -%}
                    <span class="hp-stats-title">{{ block.settings.title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <span class="hp-stats-subtitle">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </span>

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback matching Figma -->
          <div class="hp-stats-item" role="listitem">
            <span class="hp-stats-icon-badge" aria-hidden="true">
              <svg viewBox="-0.87 0.35 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8.6" r="3.1"></circle>
                <path d="M3.4 19.2a5.9 5.9 0 0 1 11.2 0"></path>
                <path d="M16.4 6.4a3 3 0 0 1 0 5.9M17.6 19.2a5.6 5.6 0 0 0-1.5-3.8"></path>
              </svg>
            </span>
            <span class="hp-stats-text">
              <span class="hp-stats-title">10,000+</span>
              <span class="hp-stats-subtitle">Happy Customers</span>
            </span>
          </div>

          <div class="hp-stats-item" role="listitem">
            <span class="hp-stats-icon-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3 2 1.6 2.5-.4 1 2.4 2.4 1-.4 2.5L21 12l-1.5 2-.4 2.5-2.4 1-1 2.4-2.5-.4L12 21l-2-1.5-2.5.4-1-2.4-2.4-1 .4-2.5L3 12l1.5-2-.4-2.5 2.4-1 1-2.4 2.5.4Z"></path>
                <path d="m8.8 12 2.2 2.2 4.2-4.4"></path>
              </svg>
            </span>
            <span class="hp-stats-text">
              <span class="hp-stats-title">Genuine</span>
              <span class="hp-stats-subtitle">Panasonic Parts</span>
            </span>
          </div>

          <div class="hp-stats-item" role="listitem">
            <span class="hp-stats-icon-badge" aria-hidden="true">
              <svg viewBox="-1 0.8 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.8 6.4h10.4v9.2H2.8z"></path>
                <path d="M13.2 9.6h3.6l2.4 2.8v3.2h-6z"></path>
                <circle cx="6.6" cy="17.4" r="1.8"></circle>
                <circle cx="16.4" cy="17.4" r="1.8"></circle>
              </svg>
            </span>
            <span class="hp-stats-text">
              <span class="hp-stats-title">Reliable</span>
              <span class="hp-stats-subtitle">&amp; On-Time Delivery</span>
            </span>
          </div>

          <div class="hp-stats-item" role="listitem">
            <span class="hp-stats-icon-badge" aria-hidden="true">
              <svg viewBox="0 1.05 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.6 15.4v-3.2a7.4 7.4 0 0 1 14.8 0v3.2"></path>
                <rect x="2.8" y="13.3" width="3.6" height="5.4" rx="1.6"></rect>
                <rect x="17.6" y="13.3" width="3.6" height="5.4" rx="1.6"></rect>
                <path d="M19.4 18.7a3.4 3.4 0 0 1-3.4 2.6h-1.6"></path>
              </svg>
            </span>
            <span class="hp-stats-text">
              <span class="hp-stats-title">Dedicated</span>
              <span class="hp-stats-subtitle">Customer Support</span>
            </span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Homepage Stats Bar",
  "tag": "section",
  "class": "section-homepage-stats-bar",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#EDF1FB"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Badge Background",
      "default": "#DCE7FB"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#0041C0"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#5A6478"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Vertical Dividers",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "users",
              "label": "Users / Customers"
            },
            {
              "value": "genuine",
              "label": "Genuine / Verified Badge"
            },
            {
              "value": "truck",
              "label": "Delivery Truck"
            },
            {
              "value": "support",
              "label": "Headset / Support"
            },
            {
              "value": "shield",
              "label": "Shield / Warranty"
            },
            {
              "value": "lock",
              "label": "Lock / Secure"
            },
            {
              "value": "return",
              "label": "Return / Exchange"
            },
            {
              "value": "star",
              "label": "Star / Rating"
            }
          ],
          "default": "users"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Optional)"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title / Stat",
          "default": "10,000+"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Happy Customers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Stats Bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "icon": "users",
            "title": "10,000+",
            "subtitle": "Happy Customers"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "genuine",
            "title": "Genuine",
            "subtitle": "Panasonic Parts"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "truck",
            "title": "Reliable",
            "subtitle": "& On-Time Delivery"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "support",
            "title": "Dedicated",
            "subtitle": "Customer Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
