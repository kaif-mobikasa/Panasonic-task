{% comment %}
  Panasonic Custom Header Section
  Shopify Online Store 2.0 Section
{% endcomment %}

{{ 'custom-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-header.js' | asset_url }}" defer="defer"></script>

<custom-header class="custom-header-section" id="Header-{{ section.id }}">
  <!-- Utility Bar -->
  {%- if section.settings.show_utility_bar -%}
    <div class="ch-utility-bar">
      <div class="ch-utility-inner">
        {%- if section.settings.utility_menu != blank and linklists[section.settings.utility_menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.utility_menu].links -%}
            <a href="{{ link.url }}" class="ch-util-link">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- if section.settings.utility_link_1_text != blank -%}
            <a href="{{ section.settings.utility_link_1_url | default: '#' }}" class="ch-util-link">
              {{- section.settings.utility_link_1_text -}}
            </a>
          {%- endif -%}
          {%- if section.settings.utility_link_2_text != blank -%}
            <a href="{{ section.settings.utility_link_2_url | default: '#' }}" class="ch-util-link">
              {{- section.settings.utility_link_2_text -}}
            </a>
          {%- endif -%}
          {%- if section.settings.utility_link_3_text != blank -%}
            <a href="{{ section.settings.utility_link_3_url | default: '#' }}" class="ch-util-link">
              {{- section.settings.utility_link_3_text -}}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <!-- Main Desktop Header (isDesk: >=1180px) -->
  <header class="ch-header-main">
    <div class="ch-desktop-only ch-desktop-inner">
      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="ch-logo-link" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'header__heading-logo ch-logo-img', alt: logo_alt }}
        {%- else -%}
          <span class="ch-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="ch-desktop-nav" aria-label="Main Navigation">
        <a href="{{ routes.root_url }}" aria-label="Home" class="ch-nav-home-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.83 2.6a1.25 1.25 0 0 0-1.66 0L3.4 9.52A1.25 1.25 0 0 0 3 10.45v8.3A1.25 1.25 0 0 0 4.25 20h4.1A1.15 1.15 0 0 0 9.5 18.85V14.6h5v4.25A1.15 1.15 0 0 0 15.65 20h4.1A1.25 1.25 0 0 0 21 18.75v-8.3a1.25 1.25 0 0 0-.4-.93z"></path></svg>
        </a>

        {%- assign main_menu = linklists[section.settings.menu] -%}
        {%- if section.settings.menu != blank and main_menu.links.size > 0 -%}
          {%- for link in main_menu.links -%}
            {%- if forloop.first or link.title == 'Appliances' -%}
              <div class="ch-nav-item-wrap" data-mega-trigger-wrap>
                <a href="{{ link.url }}" data-mega-trigger aria-expanded="false" class="ch-nav-link">
                  <span class="ch-nav-link-text">{{ link.title | escape }}</span>
                  <span class="ch-nav-link-caret">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8.5 7 7 7-7"></path></svg>
                  </span>
                </a>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="ch-nav-link">
                <span class="ch-nav-link-text">{{ link.title | escape }}</span>
                {%- if link.links.size > 0 -%}
                  <span class="ch-nav-link-caret"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8.5 7 7 7-7"></path></svg></span>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <!-- Default Reference Menu Items -->
          <div class="ch-nav-item-wrap" data-mega-trigger-wrap>
            <a href="#" data-mega-trigger aria-expanded="false" class="ch-nav-link">
              <span class="ch-nav-link-text">Appliances</span>
              <span class="ch-nav-link-caret"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8.5 7 7 7-7"></path></svg></span>
            </a>
          </div>
          <a href="#" class="ch-nav-link">
            <span class="ch-nav-link-text">Consumer electronics</span>
            <span class="ch-nav-link-caret"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8.5 7 7 7-7"></path></svg></span>
          </a>
          <a href="#" class="ch-nav-link">
            <span class="ch-nav-link-text">Accessories</span>
            <span class="ch-nav-link-caret"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8.5 7 7 7-7"></path></svg></span>
          </a>
          <a href="#" class="ch-nav-link">
            <span class="ch-nav-link-text">Error codes</span>
            <span class="ch-nav-link-caret"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8.5 7 7 7-7"></path></svg></span>
          </a>
        {%- endif -%}
      </nav>

      <!-- Search, Wishlist, Account, Cart Controls -->
      <div class="ch-actions-wrap">
        <form action="{{ routes.search_url }}" method="get" role="search" class="ch-search-input-wrap">
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search by model number or part number" aria-label="Search">
          <button type="submit" aria-label="Submit Search" class="ch-search-submit-btn">
            <svg width="19" height="19" viewBox="-0.9 -0.8 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><circle cx="10.4" cy="10.4" r="6.9"></circle><path d="m15.6 15.6 3.1 3.1"></path></svg>
          </button>
        </form>

        {%- if section.settings.show_wishlist -%}
          <a href="{{ section.settings.wishlist_url | default: '#' }}" aria-label="Wishlist" class="ch-action-btn ch-action-btn--wishlist">
            <svg width="23" height="23" viewBox="-2 -2.6 28 28" fill="none" stroke="currentColor" stroke-width="2.33" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            {%- if section.settings.wishlist_count != blank -%}
              <span class="ch-badge ch-badge--wishlist">
                {{- section.settings.wishlist_count -}}
              </span>
            {%- endif -%}
          </a>
        {%- endif -%}

        <a href="{{ routes.account_url }}" aria-label="Account" class="ch-action-btn ch-action-btn--account">
          <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7.8" r="3.9"></circle><path d="M5.6 19.2c1.3-2.6 3.6-4.1 6.4-4.1s5.1 1.5 6.4 4.1"></path></svg>
        </a>

        <a href="{{ routes.cart_url }}" aria-label="Cart" class="ch-action-btn ch-action-btn--cart">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4.6 9.4h14.8a1.8 1.8 0 0 1 1.75 2.22l-1.62 6.8A2.2 2.2 0 0 1 17.38 20H6.62a2.2 2.2 0 0 1-2.13-1.58l-1.62-6.8A1.8 1.8 0 0 1 4.6 9.4z"></path><path d="M12 9.4V4.6"></path></svg>
          <span class="ch-badge ch-badge--cart">
            {{ cart.item_count }}
          </span>
        </a>
      </div>
    </div>

    <!-- Desktop Mega Menu Panel -->
    <div data-mega-panel>
      <div data-mm="panel" class="ch-mm-card">
        <!-- Left Category Column -->
        <div class="ch-mm-cat-col">
          <a href="#" data-cat-item="kitchen" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="11" rx="1.6"></rect><path d="M6.5 10.5h6.5v4.5H6.5z"></path><path d="M16.5 10.5v0M16.5 13.2v0M16.5 15.9v0"></path></svg></span>
            <span class="ch-mm-cat-name">Kitchen</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="personal" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 3.5h5l-.6 6h-3.8z"></path><rect x="10" y="9.5" width="4" height="11" rx="1.4"></rect></svg></span>
            <span class="ch-mm-cat-name">Personal Care</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="telephone" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2.5" width="10" height="19" rx="2"></rect><path d="M10 5.5h4"></path><path d="M10 10h.01M12 10h.01M14 10h.01M10 12.5h.01M12 12.5h.01M14 12.5h.01M10 15h.01M12 15h.01M14 15h.01"></path><path d="M11 18.5h2"></path></svg></span>
            <span class="ch-mm-cat-name">Telephone &amp; Smart Home</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="audio" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5.5" y="2.5" width="13" height="19" rx="1.8"></rect><circle cx="12" cy="14.5" r="3.4"></circle><circle cx="12" cy="7.2" r="1.2"></circle></svg></span>
            <span class="ch-mm-cat-name">Audio &amp; Entertainment</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="home" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="3.5" width="15" height="17" rx="1.6"></rect><circle cx="12" cy="13" r="4"></circle><path d="M4.5 8.5h15"></path></svg></span>
            <span class="ch-mm-cat-name">Home</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="heating" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9" width="17" height="7" rx="1.6"></rect><path d="M3.5 12.5h17"></path></svg></span>
            <span class="ch-mm-cat-name">Heating &amp; Cooling</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="tv" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="12" rx="1.6"></rect><path d="M8.5 20.5h7"></path></svg></span>
            <span class="ch-mm-cat-name">TV &amp; AV</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="cameras" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12.5" rx="2"></rect><circle cx="12" cy="13.2" r="3.4"></circle><path d="M8 7l1.4-2.5h5.2L16 7"></path></svg></span>
            <span class="ch-mm-cat-name">Cameras &amp; Camcorders</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="batteries" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8.5" width="15" height="8" rx="1.6"></rect><path d="M20.5 11.2v3"></path><path d="M6 11.2v3"></path></svg></span>
            <span class="ch-mm-cat-name">Batteries &amp; Power</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
          <a href="#" data-cat-item="other" data-mm="item" class="ch-mm-cat-item">
            <span class="ch-mm-cat-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="1.4"></circle><circle cx="12" cy="12" r="1.4"></circle><circle cx="18" cy="12" r="1.4"></circle></svg></span>
            <span class="ch-mm-cat-name">Other Products</span>
            <span class="ch-mm-cat-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
          </a>
        </div>

        <!-- Right Content & Subcategories Column -->
        <div class="ch-mm-content-col">
          <!-- Main Default Promo View -->
          <div data-promo-view="main" data-mm="promo" class="ch-mm-promo-view">
            <div class="ch-mm-promo-inner">
              <div class="ch-mm-hero-card">
                <div class="ch-mm-hero-content">
                  <div class="ch-mm-eyebrow">Genuine Panasonic Parts</div>
                  {%- if section.settings.promo_appliances_heading != blank -%}
                    <h2 class="ch-mm-title">
                      {{- section.settings.promo_appliances_heading -}}
                    </h2>
                  {%- endif -%}
                  {%- if section.settings.promo_appliances_subtext != blank -%}
                    <p class="ch-mm-subtext">
                      {{- section.settings.promo_appliances_subtext -}}
                    </p>
                  {%- endif -%}
                  {%- if section.settings.promo_appliances_btn_text != blank -%}
                    <a href="{{ section.settings.promo_appliances_btn_url | default: '#' }}" class="ch-mm-btn">
                      {{- section.settings.promo_appliances_btn_text -}}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg>
                    </a>
                  {%- endif -%}
                </div>
                <div class="ch-mm-hero-img-wrap">
                  {%- if section.settings.promo_appliances_image != blank -%}
                    {%- assign promo_img_alt = section.settings.promo_appliances_heading | default: 'Kitchen appliance line-up' | escape -%}
                    {{ section.settings.promo_appliances_image | image_url: width: 800 | image_tag: class: 'ch-mm-hero-img', alt: promo_img_alt }}
                  {%- else -%}
                    <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=800&auto=format&fit=crop" alt="Kitchen appliance line-up" class="ch-mm-hero-img">
                  {%- endif -%}
                </div>
              </div>

              <!-- Feature Badges -->
              <div class="ch-mm-badges">
                <div class="ch-mm-badge-item">
                  <span class="ch-mm-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2 5 5.8v5.4c0 4 2.8 7.2 7 8.6 4.2-1.4 7-4.6 7-8.6V5.8z"></path><path d="m9.2 12 2 2 3.6-3.8"></path></svg></span>
                  <span class="ch-mm-badge-texts">
                    <span class="ch-mm-badge-title">Genuine Panasonic Parts</span>
                    <span class="ch-mm-badge-desc">Quality you can trust</span>
                  </span>
                </div>
                <div class="ch-mm-badge-item ch-mm-badge-item--border">
                  <span class="ch-mm-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.2h9.6v8.6H3z"></path><path d="M12.6 10.4h3.8L19.8 13v2.8h-7.2z"></path><circle cx="6.8" cy="17.8" r="1.7"></circle><circle cx="16.4" cy="17.8" r="1.7"></circle></svg></span>
                  <span class="ch-mm-badge-texts">
                    <span class="ch-mm-badge-title">Fast &amp; Reliable Shipping</span>
                    <span class="ch-mm-badge-desc">Get your parts, faster</span>
                  </span>
                </div>
                <div class="ch-mm-badge-item ch-mm-badge-item--border">
                  <span class="ch-mm-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.6 15.5v-3.2a7.4 7.4 0 0 1 14.8 0v3.2"></path><rect x="2.8" y="13.4" width="3.6" height="5.4" rx="1.6"></rect><rect x="17.6" y="13.4" width="3.6" height="5.4" rx="1.6"></rect><path d="M19.4 18.8a3.4 3.4 0 0 1-3.4 2.6h-1.6"></path></svg></span>
                  <span class="ch-mm-badge-texts">
                    <span class="ch-mm-badge-title">Need Help?</span>
                    <span class="ch-mm-badge-desc">Our team is here for you</span>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Kitchen Category View -->
          <div data-cat-view="kitchen" class="ch-mm-cat-view">
            <div class="ch-mm-subcat-nav">
              <div class="ch-mm-col-heading">Kitchen</div>
              <a href="#" data-subcat-item="microwave" class="ch-mm-subcat-link">
                <span class="ch-mm-subcat-text">Microwave</span>
                <span class="ch-mm-subcat-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
              </a>
              <a href="#" class="ch-mm-subcat-link">
                <span class="ch-mm-subcat-text">Toaster</span>
                <span class="ch-mm-subcat-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
              </a>
              <a href="#" class="ch-mm-subcat-link">
                <span class="ch-mm-subcat-text">Cooker</span>
                <span class="ch-mm-subcat-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path data-chev="r" d="m9 5 7 7-7 7"></path><path data-shaft="r" d="M19.5 12H5"></path></svg></span>
              </a>
